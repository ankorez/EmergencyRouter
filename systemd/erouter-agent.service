[Unit]
Description=EmergencyRouter agent (privilégié, sans accès réseau externe)
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
WorkingDirectory=/opt/erouter
ExecStart=/usr/bin/python3 -m erouter.agentd
Restart=always
RestartSec=3
RuntimeDirectory=erouter
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
