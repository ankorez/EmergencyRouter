[Unit]
Description=EmergencyRouter agent (privilégié, sans accès réseau externe)
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
WorkingDirectory=/opt/erouter
Environment=PYTHONPATH=/opt/erouter
ExecStart=/usr/bin/python3 -s -B -m erouter.agentd
Restart=always
RestartSec=3
RuntimeDirectory=erouter
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
# Pas de ProtectSystem/ProtectHome/PrivateTmp : l'agent doit pouvoir remonter / en écriture pour enregistrer
# la config (voir erouter/fs.py), ce qu'un espace de noms de montage privé compliquerait.
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=multi-user.target
