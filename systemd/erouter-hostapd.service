[Unit]
Description=EmergencyRouter hotspot (hostapd sur ap0)

[Service]
Type=simple
ExecStart=/usr/sbin/hostapd /run/erouter/hostapd.conf
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
