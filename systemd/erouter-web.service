[Unit]
Description=EmergencyRouter interface web (sans privilèges)
After=erouter-data.service erouter-agent.service
Wants=erouter-data.service erouter-agent.service

[Service]
Type=simple
User=erouter
Group=erouter
WorkingDirectory=/opt/erouter
Environment=PYTHONPATH=/opt/erouter
ExecStart=/usr/bin/python3 -s -B -m erouter.webd
Restart=always
RestartSec=3
# Seul privilège : écouter sur le port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# Système de fichiers entièrement en lecture seule : le web ne peut rien écrire (tout passe par l'agent)
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
