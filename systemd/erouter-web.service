[Unit]
Description=EmergencyRouter interface web (sans privilèges)
After=erouter-agent.service
Wants=erouter-agent.service

[Service]
Type=simple
User=erouter
Group=erouter
WorkingDirectory=/opt/erouter
ExecStart=/usr/bin/python3 -m erouter.webd
Restart=always
RestartSec=3
# Seul privilège : écouter sur le port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/erouter
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
