table inet erouter
delete table inet erouter

table inet erouter {
    chain input {
        type filter hook input priority 0; policy drop;
        iifname "lo" accept
        ct state established,related accept
        ct state invalid drop
        icmp type echo-request limit rate 10/second accept
        # depuis le LAN uniquement : DHCP, DNS, mDNS, interface web ; SSH limité en débit
        iifname "{{ bridge }}" udp dport { 53, 67, 5353 } accept
        iifname "{{ bridge }}" tcp dport { 53, {{ web_port }} } accept
        iifname "{{ bridge }}" tcp dport 22 ct state new limit rate 12/minute burst 5 packets accept
    }
    chain forward {
        type filter hook forward priority 0; policy drop;
        ct state established,related accept
        ct state invalid drop
        # anti-usurpation : un client du LAN ne peut émettre qu'avec une adresse de son réseau
        iifname "{{ bridge }}" ip saddr != {{ lan_net }} drop
        iifname "{{ bridge }}" oifname "{{ uplink }}" accept
        iifname "{{ bridge }}" oifname "{{ bridge }}" accept
    }
    chain postrouting {
        type nat hook postrouting priority 100;
        oifname "{{ uplink }}" masquerade
    }
}
