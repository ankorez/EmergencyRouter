#!/bin/sh
# Prépare /data, la partition de données d'EmergencyRouter.
#  - Avec la partition « erdata » (image EmergencyRouter) : la vérifie, la répare ou, si elle est irrécupérable
#    (coupure de courant), la recrée, puis la monte. Ne bloque JAMAIS le démarrage.
#  - Sans partition (installation manuelle) : /data est un simple dossier.
# État écrit dans $ERDATA_STATE : ok | repaired | reset | none
set -u

LABEL="${ERDATA_LABEL:-erdata}"
MNT="${ERDATA_MNT:-/data}"
STATE="${ERDATA_STATE:-/run/erouter-data.state}"
DEFAULT_CONFIG="${ERDATA_DEFAULT_CONFIG:-/usr/share/erouter/config.default.yaml}"
GROUP="${ERDATA_GROUP:-erouter}"
DEV="${ERDATA_DEV:-$(blkid -L "$LABEL" 2>/dev/null || true)}"
MOUNT_OPTS="noatime,nodev,nosuid,noexec"

log() { echo "erouter-data: $*"; }
set_state() { echo "$1" > "$STATE"; }
recreate() { mkfs.ext4 -q -F -L "$LABEL" -m 0 "$DEV" >/dev/null 2>&1; }
mount_data() { mount -o "$MOUNT_OPTS" "$DEV" "$MNT" >/dev/null 2>&1; }

mkdir -p "$MNT"

if [ -z "$DEV" ]; then
  set_state none
  log "pas de partition « $LABEL » : $MNT est un dossier ordinaire"
elif mountpoint -q "$MNT"; then
  set_state ok
else
  state=ok
  e2fsck -fp "$DEV" >/dev/null 2>&1       # -f : on vérifie à chaque démarrage (256 Mo : moins d'une seconde)
  rc=$?                                   # 0 propre | 1-3 corrigé | >=4 échec
  if [ "$rc" -ge 4 ]; then
    log "vérification en échec (code $rc) : réparation complète"
    e2fsck -fy "$DEV" >/dev/null 2>&1
    rc=$?
  fi
  if [ "$rc" -ge 4 ]; then
    log "partition irrécupérable : recréation (la configuration repart des valeurs par défaut)"
    recreate
    state=reset
  elif [ "$rc" -ge 1 ]; then
    log "partition réparée"
    state=repaired
  fi
  if ! mount_data; then
    log "montage impossible : recréation"
    recreate && mount_data && state=reset
  fi
  if mountpoint -q "$MNT"; then
    set_state "$state"
  else
    log "ATTENTION : $MNT n'a pas pu être monté, on continue avec un dossier ordinaire"
    set_state none
  fi
fi

# Arborescence (propriétaires : root ; le groupe lit la config et le certificat mais ne peut rien écrire)
if ! install -d -m 750 -o root -g "$GROUP" "$MNT/erouter" 2>/dev/null; then
  install -d -m 750 "$MNT/erouter"
fi
install -d -m 700 "$MNT/nm-connections"           # profils Wi-Fi de NetworkManager
install -d -m 700 "$MNT/nm-state"                 # état de NetworkManager
if [ ! -f "$MNT/erouter/config.yaml" ] && [ -f "$DEFAULT_CONFIG" ]; then
  if ! install -m 640 -o root -g "$GROUP" "$DEFAULT_CONFIG" "$MNT/erouter/config.yaml" 2>/dev/null; then
    install -m 640 "$DEFAULT_CONFIG" "$MNT/erouter/config.yaml"
  fi
  log "configuration par défaut installée"
fi
sync
exit 0
