#!/bin/sh
# Protection de la carte SD : erouter-fs status | lock | unlock   (lock/unlock demandent sudo)
set -eu
if [ "${1:-status}" != "status" ] && [ "$(id -u)" -ne 0 ]; then
  echo "Lance : sudo erouter-fs $1" >&2
  exit 1
fi
export PYTHONPATH=/opt/erouter
exec /usr/bin/python3 -s -B -m erouter.fs "$@"
